{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentience.invalid/schemas/private-test-access-v1.json",
  "title": "Sentience PrivateTest access marker",
  "type": "object",
  "required": ["schema", "status", "candidate_identity", "private_test_access"],
  "properties": {
    "schema": {"const": "private-test-access/v1"},
    "status": {"enum": ["reserved", "accepted", "failed"]},
    "candidate_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "private_test_access": {"type": "boolean"}
  }
}
